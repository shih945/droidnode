              "type": "string"
            }
          },
          {
            "name": "stdin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "stdout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "stderr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "tty",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ]
      },
      "post": {
        "summary": "附加到容器（SPDY，POST）",
        "description": "与 GET 相同。",
        "tags": [
          "spdy"
        ],
        "security": [
          {
            "ClientCertificate": []
          }
        ],
        "x-droidnode-auth": "client-cert",
        "x-droidnode-transport": "spdy",
        "responses": {
          "101": {
            "description": "SPDY 升级成功"
          },
          "400": {
            "description": "不是 SPDY",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": ""
              }
            }
          },
          "403": {
            "description": "没有客户端证书",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": ""
