<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 构建：把新控制台的五个页面开放给 adb 启动，方便在真机上预览，
     不用改主入口。release 构建不含这个文件，页面保持 exported=false。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <activity
            android:name=".ui.v2.NodeActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".ui.v2.PodsActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".ui.v2.ImagesActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".ui.v2.LogsActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".ui.v2.SettingsActivity"
            android:exported="true"
            tools:replace="android:exported" />

    </application>
</manifest>
