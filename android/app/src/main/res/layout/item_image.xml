<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/imageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/fs_m"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/imageSub"
            style="@style/T.MonoSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_1" />
    </LinearLayout>

    <TextView
        android:id="@+id/imageSide"
        style="@style/T.MonoSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sp_2" />

    <ImageView
        android:layout_width="@dimen/h_icon_s"
        android:layout_height="@dimen/h_icon_s"
        android:layout_marginLeft="@dimen/sp_2"
        android:src="@drawable/ic_chevron"
        android:tint="@color/text_3"
        android:importantForAccessibility="no" />
</LinearLayout>
