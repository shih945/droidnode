<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/sp_4"
    android:paddingRight="@dimen/sp_4"
    android:paddingTop="@dimen/sp_2"
    android:paddingBottom="@dimen/sp_2">

    <TextView
        android:id="@+id/logTime"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="@dimen/fs_2xs"
        android:textColor="@color/text_3" />

    <TextView
        android:id="@+id/logLevel"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="@dimen/fs_2xs"
        android:textStyle="bold"
        android:textColor="@color/text_3" />

    <TextView
        android:id="@+id/logMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textSize="@dimen/fs_xs"
        android:textColor="@color/text_2"
        android:lineSpacingMultiplier="1.35" />
</LinearLayout>
