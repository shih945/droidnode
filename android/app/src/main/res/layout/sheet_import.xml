<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/sp_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/T.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sheet_import_01" />

        <ImageView
            android:id="@+id/importClose"
            android:layout_width="@dimen/tap"
            android:layout_height="@dimen/tap"
            android:padding="@dimen/sp_3"
            android:src="@drawable/ic_close"
            android:tint="@color/text_2"
            android:contentDescription="@string/sheet_image_02" />
    </LinearLayout>

    <EditText
        android:id="@+id/importText"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/sp_2"
        android:background="@drawable/bg_input"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="apiVersion: v1 …"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="4"
        android:padding="@dimen/sp_3"
        android:scrollbars="vertical"
        android:textColor="@color/text"
        android:textColorHint="@color/text_3"
        android:textSize="@dimen/fs_xs" />

    <TextView
        android:id="@+id/importHint"
        style="@style/T.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_2"
        android:text="@string/sheet_import_02" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_4"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/importPick"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/tap"
            android:layout_weight="1"
            android:text="@string/join_16" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/importCancel"
            style="@style/Btn.Quiet"
            android:layout_width="0dp"
            android:layout_height="@dimen/tap"
            android:layout_weight="1"
            android:text="@string/sheet_confirm_02" />

        <TextView
            android:id="@+id/importOk"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/tap"
            android:layout_marginLeft="@dimen/sp_3"
            android:layout_weight="1"
            android:text="@string/sheet_import_03" />
    </LinearLayout>
</LinearLayout>
