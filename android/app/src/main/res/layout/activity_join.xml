<?xml version="1.0" encoding="utf-8"?>
<!-- 加入集群：二级页。顶栏在系统状态栏之下（BaseActivity 补 inset），底部主操作固定在拇指区。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Appbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/h_appbar">

        <ImageView
            android:id="@+id/joinBack"
            android:layout_width="@dimen/tap"
            android:layout_height="@dimen/tap"
            android:contentDescription="@string/join_01"
            android:padding="@dimen/sp_3"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            android:tint="@color/text_2" />

        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/sp_2"
            android:text="@string/join_02" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/joinScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sp_4">

            <LinearLayout
                style="@style/SectionHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/joinTickMode"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />

                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/join_03" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/joinModeToken"
                style="@style/Choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/joinDotToken"
                    android:layout_width="@dimen/sp_4"
                    android:layout_height="@dimen/sp_4"
                    android:layout_marginRight="@dimen/sp_3"
                    android:background="@drawable/bg_choice_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/ChoiceTitle" android:text="@string/join_04" />

                    <TextView style="@style/ChoiceNote" android:text="@string/join_05" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/joinModeFile"
                style="@style/Choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2">

                <View
                    android:id="@+id/joinDotFile"
                    android:layout_width="@dimen/sp_4"
                    android:layout_height="@dimen/sp_4"
                    android:layout_marginRight="@dimen/sp_3"
                    android:background="@drawable/bg_choice_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/ChoiceTitle" android:text="@string/join_06" />

                    <TextView style="@style/ChoiceNote" android:text="@string/join_07" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/joinModePaste"
                style="@style/Choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2">

                <View
                    android:id="@+id/joinDotPaste"
                    android:layout_width="@dimen/sp_4"
                    android:layout_height="@dimen/sp_4"
                    android:layout_marginRight="@dimen/sp_3"
                    android:background="@drawable/bg_choice_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/ChoiceTitle" android:text="@string/join_08" />

                    <TextView style="@style/ChoiceNote" android:text="@string/join_09" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SectionHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/joinTickCred"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />

                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/join_10" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/joinHint"
                    style="@style/T.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/sp_2"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/panelToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/join_11" />

                    <EditText
                        android:id="@+id/joinServer"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:layout_marginTop="@dimen/sp_1"
                        android:background="@drawable/bg_input"
                        android:hint="https://192.168.2.7:6443"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/sp_3"
                        android:paddingRight="@dimen/sp_3"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_3" />

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:text="token" />

                    <EditText
                        android:id="@+id/joinToken"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:layout_marginTop="@dimen/sp_1"
                        android:background="@drawable/bg_input"
                        android:hint="kubectl create token …"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/sp_3"
                        android:paddingRight="@dimen/sp_3"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_3" />

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:text="@string/join_12" />

                    <EditText
                        android:id="@+id/joinCa"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_1"
                        android:background="@drawable/bg_input"
                        android:gravity="top|start"
                        android:hint="@string/join_13"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minHeight="72dp"
                        android:padding="@dimen/sp_3"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/joinWarn"
                        style="@style/T.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/sp_2"
                        android:text="@string/join_14"
                        android:textColor="@color/lamp"
                        android:visibility="gone" />

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/join_15" />

                    <EditText
                        android:id="@+id/joinText"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="@dimen/sp_1"
                        android:background="@drawable/bg_input"
                        android:gravity="top|start"
                        android:hint="apiVersion: v1 …"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:padding="@dimen/sp_3"
                        android:scrollbars="vertical"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_3" />

                    <TextView
                        android:id="@+id/pickFile"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:layout_marginTop="@dimen/sp_2"
                        android:text="@string/join_16" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rule_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/night"
        android:orientation="vertical"
        android:padding="@dimen/sp_3">

        <TextView
            android:id="@+id/joinGo"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tap"
            android:text="@string/join_17" />
    </LinearLayout>
</LinearLayout>
