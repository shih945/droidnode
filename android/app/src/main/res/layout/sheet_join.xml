<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/sp_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/T.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sheet_join_01" />

        <ImageView
            android:id="@+id/joinClose"
            android:layout_width="@dimen/tap"
            android:layout_height="@dimen/tap"
            android:contentDescription="@string/sheet_image_02"
            android:padding="@dimen/sp_3"
            android:src="@drawable/ic_close"
            android:tint="@color/text_2" />
    </LinearLayout>

    <TextView
        style="@style/T.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_2"
        android:text="@string/join_11" />

    <EditText
        android:id="@+id/joinServer"
        style="@style/T.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_1"
        android:background="@drawable/bg_input"
        android:hint="https://192.0.2.10:6443"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:padding="@dimen/sp_3"
        android:textColor="@color/text"
        android:textColorHint="@color/text_3" />

    <TextView
        style="@style/T.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_3"
        android:text="token" />

    <EditText
        android:id="@+id/joinToken"
        style="@style/T.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_1"
        android:background="@drawable/bg_input"
        android:hint="eyJhbGciOi…"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:maxLines="2"
        android:padding="@dimen/sp_3"
        android:textColor="@color/text"
        android:textColorHint="@color/text_3" />

    <TextView
        style="@style/T.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_3"
        android:text="@string/sheet_join_02" />

    <EditText
        android:id="@+id/joinCa"
        style="@style/T.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_1"
        android:background="@drawable/bg_input"
        android:hint="-----BEGIN CERTIFICATE-----"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="3"
        android:padding="@dimen/sp_3"
        android:textColor="@color/text"
        android:textColorHint="@color/text_3" />

    <TextView
        android:id="@+id/joinHint"
        style="@style/T.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_2"
        android:text="@string/sheet_join_03" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_4"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/joinCancel"
            style="@style/Btn.Quiet"
            android:layout_width="0dp"
            android:layout_height="@dimen/tap"
            android:layout_weight="1"
            android:text="@string/sheet_confirm_02" />

        <TextView
            android:id="@+id/joinOk"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/tap"
            android:layout_marginLeft="@dimen/sp_3"
            android:layout_weight="1"
            android:text="@string/join_17" />
    </LinearLayout>
</LinearLayout>
