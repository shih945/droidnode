<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/night">

    <LinearLayout style="@style/Appbar">

        <ImageView
            android:id="@+id/settingsBack"
            android:layout_width="@dimen/tap"
            android:layout_height="@dimen/tap"
            android:contentDescription="@string/v2_settings_52"
            android:padding="@dimen/sp_3"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            android:tint="@color/text_2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settingsTitle"
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/sp_2"
            android:text="@string/v2_settings_01" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/pill"
            style="@style/Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <View android:id="@+id/pillDot" style="@style/Dot" />

            <TextView
                android:id="@+id/pillText"
                style="@style/T.Body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/v2_images_02" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rule_soft" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page">

            <!-- 设置首页：状态摘要 + 五个入口 + 关于 -->
            <LinearLayout
                android:id="@+id/pageHub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/T.Body2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/v2_settings_65" />

                            <TextView
                                android:id="@+id/hubNode"
                                style="@style/T.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sp_1"
                                android:text="—" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/T.Body2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/v2_settings_66" />

                            <TextView
                                android:id="@+id/hubControl"
                                style="@style/T.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sp_1"
                                android:text="—" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/hubState"
                            style="@style/T.Body2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="—" />

                        <TextView
                            android:id="@+id/hubRestart"
                            style="@style/Btn.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/tap"
                            android:text="@string/v2_settings_25" />

                        <TextView
                            android:id="@+id/hubStop"
                            style="@style/Btn.Danger"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/tap"
                            android:layout_marginLeft="@dimen/sp_2"
                            android:text="@string/v2_settings_27" />

                        <TextView
                            android:id="@+id/hubStart"
                            style="@style/Btn.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/tap"
                            android:visibility="gone"
                            android:text="@string/v2_settings_67" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/SectionHead" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.droidnode.ui.v2.PulseView
                        android:id="@+id/tickPages"
                        android:layout_width="24dp"
                        android:layout_height="@dimen/h_pulse_mini" />
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:text="@string/v2_settings_01" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hubEntries"
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            <!-- 关于 -->
            <LinearLayout style="@style/SectionHead" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/tickAbout"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/v2_settings_44" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/aboutVersion"
                    style="@style/T.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DroidNode" />

                <TextView
                    style="@style/T.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2"
                    android:text="@string/v2_settings_45" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageCluster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- 控制面 -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/v2_node_06"
                        android:textColor="@color/text"
                        android:textSize="@dimen/fs_m"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/kubeStatus"
                        style="@style/T.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/v2_settings_02" />
                </LinearLayout>

                <TextView
                    android:id="@+id/kubeServer"
                    style="@style/T.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2"
                    android:text="—" />

                <TextView
                    android:id="@+id/kubePath"
                    style="@style/T.MonoSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_1"
                    android:text="—" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/v2_settings_03" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/kubeAuth"
                        style="@style/T.MonoSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnJoin"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/tap"
                        android:layout_weight="1"
                        android:text="@string/join_02" />

                    <TextView
                        android:id="@+id/btnTest"
                        style="@style/Btn.Quiet"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:layout_weight="1"
                        android:text="@string/v2_settings_04" />
                </LinearLayout>

                <TextView
                    android:id="@+id/testHint"
                    style="@style/T.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2"
                    android:visibility="gone" />
            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageNode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- 节点 -->
            <LinearLayout style="@style/SectionHead" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/tickNode"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/v2_node_01" />
            </LinearLayout>

            <LinearLayout
                style="@style/ListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/RowV" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout style="@style/Kv" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/v2_node_05" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/v2_settings_05" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/editNodeName"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:background="@drawable/bg_input"
                        android:hint="droidnode-xxxxxxxx"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:padding="@dimen/sp_3"
                        android:textColorHint="@color/text_3" />
                </LinearLayout>

                <LinearLayout style="@style/RowV" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout style="@style/Kv" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/v2_settings_06" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1024 – 65535" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/editPort"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:background="@drawable/bg_input"
                        android:hint="10255"
                        android:inputType="number"
                        android:maxLength="5"
                        android:maxLines="1"
                        android:padding="@dimen/sp_3"
                        android:textColorHint="@color/text_3" />
                </LinearLayout>

                <LinearLayout style="@style/RowV" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout style="@style/Kv" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/v2_settings_07" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/v2_settings_08" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/editMirrorDocker"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:background="@drawable/bg_input"
                        android:hint="@string/v2_settings_09"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:padding="@dimen/sp_3"
                        android:textColorHint="@color/text_3" />
                    <EditText
                        android:id="@+id/editMirrorK8s"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:background="@drawable/bg_input"
                        android:hint="@string/v2_settings_10"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:padding="@dimen/sp_3"
                        android:textColorHint="@color/text_3" />
                    <EditText
                        android:id="@+id/editMirrorQuay"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:background="@drawable/bg_input"
                        android:hint="@string/v2_settings_11"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:padding="@dimen/sp_3"
                        android:textColorHint="@color/text_3" />
                    <TextView
                        android:id="@+id/cfgRegistry"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:text="—"
                        android:textColor="@color/text_3" />
                </LinearLayout>

                <LinearLayout style="@style/RowV" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout style="@style/Kv" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/v2_settings_12" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="error / warn / info / debug / trace" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/editLogLevel"
                        style="@style/T.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_2"
                        android:background="@drawable/bg_input"
                        android:hint="info"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:padding="@dimen/sp_3"
                        android:textColorHint="@color/text_3" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/configHint"
                style="@style/T.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSaveConfig"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tap"
                android:layout_marginTop="@dimen/sp_3"
                android:text="@string/v2_settings_13" />

            <TextView
                style="@style/T.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:text="@string/v2_settings_14" />

            <!-- 网络 -->
            <LinearLayout style="@style/SectionHead" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/tickNet"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/v2_settings_15" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/T.Body2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/v2_settings_16" />

                <RadioGroup
                    android:id="@+id/ifaceGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2" />
            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageRuntime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- 运行控制 -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_18"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/runState"
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_images_02" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/rule_soft" />

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_19"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/agentReport"
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_settings_20" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/rule_soft" />

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_21"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/maintainSub"
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_settings_22" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchMaintain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/sp_3"
                        android:minHeight="@dimen/tap"
                        android:minWidth="@dimen/tap"
                        android:thumbTint="@color/switch_thumb"
                        android:trackTint="@color/switch_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/rule_soft" />

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_23"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_settings_24" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnRestartAgent"
                        style="@style/Btn.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:text="@string/v2_settings_25" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/rule_soft" />

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/agentPowerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_26"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/agentPowerSub"
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_images_02" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnStopAgent"
                        style="@style/Btn.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:text="@string/v2_settings_27" />

                    <TextView
                        android:id="@+id/btnStartAgent"
                        style="@style/Btn.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:visibility="gone"
                        android:text="@string/v2_settings_67" />
                </LinearLayout>
            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/pagePower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- 电源与后台 -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_29"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/batterySub"
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_settings_30" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnBattery"
                        style="@style/Btn.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:text="@string/v2_settings_31" />
                </LinearLayout>

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_32"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_settings_33" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAutostart"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:contentDescription="@string/v2_settings_32" />
                </LinearLayout>

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_46"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_settings_47" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchKeepOnline"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:contentDescription="@string/v2_settings_46" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- 外观 -->
            <LinearLayout style="@style/SectionHead" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/tickLook"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/v2_settings_36" />
            </LinearLayout>

            <LinearLayout
                style="@style/ListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioGroup
                    android:id="@+id/appearanceGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/sp_4"
                    android:paddingRight="@dimen/sp_4"
                    android:paddingTop="@dimen/sp_2"
                    android:paddingBottom="@dimen/sp_2">

                    <RadioButton
                        android:id="@+id/appearanceSystem"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:buttonTint="@color/lamp"
                        android:text="@string/v2_settings_37"
                        android:textColor="@color/text"
                        android:textSize="@dimen/fs_m" />

                    <RadioButton
                        android:id="@+id/appearanceLight"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:buttonTint="@color/lamp"
                        android:text="@string/v2_settings_38"
                        android:textColor="@color/text"
                        android:textSize="@dimen/fs_m" />

                    <RadioButton
                        android:id="@+id/appearanceDark"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:buttonTint="@color/lamp"
                        android:text="@string/v2_settings_39"
                        android:textColor="@color/text"
                        android:textSize="@dimen/fs_m" />
                </RadioGroup>
            </LinearLayout>

            <!-- 语言 -->
            <LinearLayout style="@style/SectionHead" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/tickLang"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/settings_language_title" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/T.Body2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_hint" />

                <RadioGroup
                    android:id="@+id/langGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2">

                    <RadioButton
                        android:id="@+id/langSystem"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:buttonTint="@color/lamp"
                        android:text="@string/settings_language_system"
                        android:textColor="@color/text"
                        android:textSize="@dimen/fs_m" />

                    <RadioButton
                        android:id="@+id/langZh"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:buttonTint="@color/lamp"
                        android:text="@string/settings_language_zh"
                        android:textColor="@color/text"
                        android:textSize="@dimen/fs_m" />

                    <RadioButton
                        android:id="@+id/langEn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap"
                        android:buttonTint="@color/lamp"
                        android:text="@string/settings_language_en"
                        android:textColor="@color/text"
                        android:textSize="@dimen/fs_m" />
                </RadioGroup>
            </LinearLayout>

            <!-- 诊断 -->
            <LinearLayout style="@style/SectionHead" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.droidnode.ui.v2.PulseView
                    android:id="@+id/tickDiag"
                    android:layout_width="24dp"
                    android:layout_height="@dimen/h_pulse_mini" />
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sp_2"
                    android:text="@string/v2_settings_40" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/Row" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/v2_settings_41"
                            android:textColor="@color/text"
                            android:textSize="@dimen/fs_m"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/T.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_1"
                            android:text="@string/v2_settings_42" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnExport"
                        style="@style/Btn.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tap"
                        android:layout_marginLeft="@dimen/sp_2"
                        android:text="@string/v2_settings_43" />
                </LinearLayout>
            </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rule_soft" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
